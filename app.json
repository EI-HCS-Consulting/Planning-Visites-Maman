{
  "expo": {
    "name": "AvecToi",
    "slug": "avectoi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "avectoi",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B2E"
      },
      "package": "care.avectoi.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "AvecToi accède à vos photos pour partager des souvenirs.",
          "cameraPermission": "AvecToi accède à votre caméra pour prendre des photos."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "AvecToi accède à votre calendrier pour ajouter vos créneaux de visite."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
